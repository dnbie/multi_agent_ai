# Streamlit Cloud Secrets Configuration
# Copy this to .streamlit/secrets.toml and fill in your values
# DO NOT commit secrets.toml to version control!

# Google Gemini API Key (Required for AI features)
GOOGLE_API_KEY = "your-google-gemini-api-key"

# OpenAI API Key (Optional fallback)
OPENAI_API_KEY = "your-openai-api-key"

# Weather API Key (OpenWeatherMap)
WEATHER_API_KEY = "your-openweathermap-api-key"

# News API Key (NewsAPI.org)
NEWS_API_KEY = "your-newsapi-key"

# Aviation Stack API Key (Flight search)
AVIATION_STACK_API_KEY = "your-aviationstack-api-key"

# Email Configuration (Optional - for Email Agent)
SMTP_SERVER = "smtp.gmail.com"
SMTP_PORT = 587
EMAIL_ADDRESS = ""
EMAIL_PASSWORD = ""
